# ── Expo / React Native (client) ─────────────────────────────────────────────
EXPO_PUBLIC_AGORA_APP_ID=your_32_char_agora_app_id

# ── Django backend only ──────────────────────────────────────────────────────
AGORA_APP_ID=your_32_char_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate

# ── Android push (required for ExponentPushToken on physical device) ─────────
# 1. Create a Firebase project → add Android app (package: com.anonymous.smartaid)
# 2. Download google-services.json → place in project root
# 3. In app.json under expo.android add: "googleServicesFile": "./google-services.json"
# 4. Upload FCM V1 key: https://expo.dev → Project → Credentials → Android
# 5. Rebuild: npx expo run:android
