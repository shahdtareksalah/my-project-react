{
  "expo": {
    "name": "SmartAid",
    "slug": "smartaid",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 34,
            "minSdkVersion": 24,
            "enableDangerousReferenceCleaning": true
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ffffff",
          "mode": "production"
        }
      ],
      "expo-location",
      "expo-camera"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.smartaid",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow SmartAid to access your camera for AI-powered assistance.",
        "NSMicrophoneUsageDescription": "Allow SmartAid to access your microphone for audio calls and voice features.",
        "NSLocationWhenInUseUsageDescription": "Allow SmartAid to access your location for safety features.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.anonymous.smartaid",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ],
      "edgeToEdgeEnabled": true,
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "agoraAppId": "0dc49feab67c4c67b946bae72254a9af",
      "eas": {
        "projectId": "0f32d99e-8ea1-4138-abe6-43f7cda1177c"
      }
    },
    "owner": "smartaid123"
  }
}
